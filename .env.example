# Copy to .env for local development only. Never commit a real .env file.
# In deployed environments, these are NOT read from env vars — the auth-broker
# Lambda reads OAuth client secrets from AWS Secrets Manager at runtime instead.

# --- Local dev only ---
AWS_REGION=us-east-1
SCENETTE_ENV=dev

# OAuth apps (local dev values only; real values live in Secrets Manager per-env)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Session signing (local dev only; real value is a Secrets Manager secret in deployed envs)
SESSION_JWT_SECRET=
