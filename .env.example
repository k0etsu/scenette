# Copy to .env for local development only. Never commit a real .env file.
# In deployed environments these are NOT read from env vars -- CDK wires each
# Lambda's actual table names/ARNs/addresses directly (see
# infra/lib/scenette-stack.ts). This file only matters if you're invoking a
# Lambda handler locally against real AWS resources.

AWS_REGION=us-east-1
SCENETTE_ENV=dev

# services/accounts
ACCOUNTS_TABLE=
SESSIONS_TABLE=
MEMBERSHIPS_TABLE=
INVITES_TABLE=
EMAIL_VERIFICATIONS_TABLE=
# The account-deletion cascade also touches the room/asset resources.
ROOMS_TABLE=
ASSETS_TABLE=
ASSETS_BUCKET=
# From-address for verification emails -- must be an address @ a domain
# verified in SES (see README's "Deploying" section for the sandbox
# production-access step this also depends on). The verify link's origin is
# taken from the incoming request, so there's no HTTP_API_URL to configure.
VERIFICATION_FROM_ADDRESS=
