{
  "app": "npx ts-node --prefer-ts-exts bin/scenette.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "cdk.out"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "skipEmailVerification": true,
    "discordClientId": "1538008456441626635",
    "discordClientParamName": "/scenette/discord-client",
    "discordClientParamVersion": 1
  }
}
